{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "defaults": {
    "model": "claude-opus-5-5",
    "reasoning_effort": "high",
    "recent_turns": 10,
    "summary_days": 1
  },
  "models": {
    "claude-sonnet-5": { "family": "anthropic" },
    "claude-fable-5": { "family": "anthropic" },
    "claude-haiku-4-5": { "family": "anthropic" },
    "claude-opus-5-5": { "family": "anthropic" }
  },
  "agents": {
    "claude": {
      "model": "claude-opus-5-5",
      "fallback_model": "claude-sonnet-5",
      "reasoning_effort": "high",
      "chrome": false
    }
  },
  "telegram": {
    "progress": true,
    "rotate_tokens": 150000,
    "motd": true,
    "voice": { "model": "small", "language": "" },
    "sentry": {
      "active": false,
      "every_minutes": 5,
      "cleared": true,
      "sources": [
        {
          "name": "Monitoring",
          "server": "your-monitoring-mcp",
          "tool": "active_alerts",
          "args": { "min_severity": 2 },
          "list": "result",
          "id": "AlertID",
          "title": "AlertName",
          "object": ["EntityCaption", "NodeCaption"],
          "severity": "SeverityText",
          "time": "TriggeredDateTime",
          "skip_if": "Acknowledged",
          "only": { "Severity": [2, 3] },
          "object_lookup": { "tool": "get_entity", "args": { "id": "{EntityID}" }, "field": "entity.name" }
        }
      ]
    }
  },
  "approval": {
    "enabled": true,
    "timeout_seconds": 600,
    "extra_patterns": []
  }
}
